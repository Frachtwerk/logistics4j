<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- Synthetic test DTD with the shapes of a status file: Größen, Gruppen, Wiederholungen -->
<!ELEMENT TOURS (TOUR)>
<!ELEMENT TOUR (LEG_HEAD?, SHIPMENT+)+>
<!ELEMENT LEG_HEAD (LEG_NO?, LEG_DRIVER?)>
<!ELEMENT LEG_NO (#PCDATA)>
<!ELEMENT LEG_DRIVER (#PCDATA)>
<!ELEMENT SHIPMENT (HEAD, ITEM+)>
<!ELEMENT HEAD (ID, SENDER?, STATUS, NOTE?)>
<!ELEMENT ID (#PCDATA)>
<!ELEMENT SENDER (NAME, CITY)>
<!ELEMENT NAME (#PCDATA)>
<!ELEMENT CITY (#PCDATA)>
<!ELEMENT STATUS (CODE?, TEXT?)>
<!ELEMENT CODE (#PCDATA)>
<!ELEMENT TEXT (#PCDATA)>
<!ELEMENT NOTE (#PCDATA)>
<!ATTLIST NOTE lang CDATA #IMPLIED>
<!ELEMENT ITEM (COUNT?, LABEL, CODES*)+>
<!ELEMENT COUNT (#PCDATA)>
<!ELEMENT LABEL (#PCDATA)>
<!ELEMENT CODES (KIND, VALUE, STATE?)*>
<!ELEMENT KIND (#PCDATA)>
<!ELEMENT VALUE (#PCDATA)>
<!ELEMENT STATE (#PCDATA)>
